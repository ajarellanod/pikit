{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Workers' runtime types, not Bun's: what the lane and the components it imports compile against.
    // worker-configuration.d.ts is generated by `wrangler types` (the `typecheck` script), not committed.
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
