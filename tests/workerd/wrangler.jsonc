// The Worker the workerd lane runs its suites in (README.md). Never deployed.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pikit-workerd-tests",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Vitest's runner inside workerd needs it; the components under test do not.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "OBJECTS", "class_name": "TestObject" },
      // deployment-cloudflare's class, under the binding its entrypoint reads (src/deployment.ts).
      { "name": "CONVERSATION", "class_name": "Conversation" }
    ]
  },
  // SQLite-backed, as a conversation's object is on Cloudflare (SPEC C1, C5).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TestObject"] },
    { "tag": "v2", "new_sqlite_classes": ["Conversation"] }
  ],
  // The version deployment-cloudflare's /health reports.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // A variable secrets-cloudflare must read back from the real env.
  "vars": { "PIKIT_WORKERD_VAR": "from wrangler vars" }
}
