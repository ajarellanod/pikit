{
  "$schema": "../../schema/component.schema.json",
  "name": "tool-read",
  "version": "0.0.1",
  "description": "Pi's own `read` tool, for the agents that name it: it reads a text file (from a line, up to a number of lines) or an image, and truncates long files for the model.",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.1",
    "adapter": "0.0.1",
    "capabilities": [
      "execution"
    ]
  },
  "optional": {
    "capabilities": [
      "workspace"
    ]
  },
  "provides": [
    "agent.tool"
  ],
  "replay": {
    "tools": {
      "read": "safe"
    }
  },
  "dependencies": {
    "@pikit/pi-adapter": "0.0.1"
  },
  "devDependencies": {
    "@pikit/contracts": "0.0.1"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
