{
  "$schema": "../../schema/component.schema.json",
  "name": "channel-http",
  "version": "0.0.0",
  "title": "HTTP API: call your agent from your own code (POST /v1/messages)",
  "description": "Talk to an agent over HTTP: send a message, get the answer in the response.",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.0",
    "contracts": "0.0.0",
    "capabilities": [
      "secrets",
      "conversations.registry",
      "agent.runtime",
      "actor.mailbox"
    ]
  },
  "optional": {
    "capabilities": [
      "agent.submissions",
      "actor.inbox"
    ]
  },
  "provides": [
    "http.route"
  ],
  "apps": {
    "worker": "worker"
  },
  "halves": {
    "default": {
      "provides": [
        "http.route"
      ],
      "requires": [
        "secrets",
        "conversations.registry",
        "agent.runtime"
      ],
      "optional": [
        "agent.submissions",
        "actor.inbox",
        "actor.mailbox"
      ]
    },
    "worker": {
      "provides": [
        "http.route"
      ],
      "requires": [
        "secrets",
        "actor.mailbox"
      ],
      "optional": []
    }
  },
  "dependencies": {
    "@pikit/contracts": "0.0.0",
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ],
  "environment": [
    {
      "name": "PIKIT_HTTP_TOKEN",
      "secret": true,
      "required": true,
      "description": "Bearer token every request must carry; at least 16 characters (for example `openssl rand -hex 32`)."
    }
  ]
}
