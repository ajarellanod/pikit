// A sandbox host's wrangler.jsonc (execution-cloudflare-sandbox's README): deployment-cloudflare's own,
// plus the `Sandbox` Durable Object class and its container. Copy it over the project's wrangler.jsonc
// once, after `pikit add execution-cloudflare-sandbox`, and add to src/pikit/deployment-cloudflare/worker.ts:
//
//   export { Sandbox } from "../execution-cloudflare-sandbox/entrypoint.ts";
//
// Workers Paid is required (Containers). No "name": `pikit up` names the Worker after package.json's.
// Secrets are never here: `pikit up` uploads .env's (PIKIT_SANDBOX_TOKEN and storage-blob-s3's keys).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/pikit/deployment-cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      // deployment-cloudflare's: its /health starts one, which runs the default App without a container.
      { "name": "CONVERSATION", "class_name": "Conversation" },
      // One per sandbox id and agent (execution-cloudflare-sandbox-worker's `binding`).
      { "name": "SANDBOX", "class_name": "Sandbox" }
    ]
  },
  // A migration is forever: add new ones below, never edit or remove one.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Conversation"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      // The object starts and stops its own container (ctx.container), with the image its agent gets.
      "scheduling_policy": "durable_object",
      // Containers running at once, across every sandbox: past it a start never happens, and the
      // sandbox answers 503 after `startSeconds`.
      "max_instances": 10,
      // The default size; an agent's profile may start a larger one (`instance`).
      "instance_type": "lite",
      // Names the component's config uses (`image`, `agents.<agent>.image`). Paths are from this file;
      // each build context is its Dockerfile's directory, where the helper (pikit-sandbox) is.
      "images": {
        "base": { "dockerfile": "./src/pikit/execution-cloudflare-sandbox/images/base.Dockerfile" },
        "designer": { "dockerfile": "./src/pikit/execution-cloudflare-sandbox/images/designer.Dockerfile" }
      }
    }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
