{
  "$schema": "../../schema/component.schema.json",
  "name": "admin-api",
  "version": "0.0.1",
  "title": "Admin API: what the dashboard reads and does (/admin/api/*), and its built files (/admin/)",
  "description": "The operator's HTTP API: the composition, conversations (a view of conversations.directory: one title, archive and delete for everyone, hide for me), transcripts, live events, messages, abort and reset; serves the dashboard's built files. On Cloudflare the Worker serves it, asking the directory and reaching each conversation's Durable Object.",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.1",
    "contracts": "0.0.1",
    "capabilities": [
      "admin.auth",
      "agent.observe",
      "agent.runtime",
      "conversations.registry",
      "conversations.directory",
      "actor.mailbox"
    ]
  },
  "optional": {
    "capabilities": [
      "outbound.queue",
      "actor.inbox",
      "agent.definition",
      "agent.directory",
      "agent.tool",
      "agent.skill",
      "agent.command"
    ]
  },
  "provides": [
    "http.route",
    "agent.command"
  ],
  "apps": {
    "worker": "worker"
  },
  "halves": {
    "default": {
      "provides": [
        "http.route",
        "agent.command"
      ],
      "requires": [
        "admin.auth",
        "agent.observe",
        "agent.runtime",
        "conversations.registry",
        "conversations.directory"
      ],
      "optional": [
        "outbound.queue",
        "actor.inbox",
        "agent.definition",
        "agent.directory",
        "agent.tool",
        "agent.skill",
        "agent.command"
      ]
    },
    "worker": {
      "provides": [
        "http.route"
      ],
      "requires": [
        "admin.auth",
        "actor.mailbox",
        "conversations.directory"
      ],
      "optional": []
    }
  },
  "generated": [
    "dashboard-files.ts"
  ],
  "dependencies": {
    "@pikit/contracts": "0.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@pikit/pi-adapter": "0.0.1"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
