{
  "$schema": "../../schema/component.schema.json",
  "name": "admin-api",
  "version": "0.0.0",
  "title": "Admin API: what the dashboard reads and does (/admin/api/*), and its built files (/admin/)",
  "description": "The operator's HTTP API: the composition, conversations, transcripts, live events, messages, abort and reset; serves the dashboard's built files. On Cloudflare the Worker serves it, reaching each conversation's Durable Object and listing them from an index.",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.0",
    "contracts": "0.0.0",
    "capabilities": [
      "admin.auth",
      "agent.observe",
      "agent.runtime",
      "conversations.registry",
      "storage.sql",
      "actor.mailbox"
    ]
  },
  "optional": {
    "capabilities": [
      "outbound.queue",
      "actor.inbox"
    ]
  },
  "provides": [
    "http.route"
  ],
  "apps": {
    "worker": "worker"
  },
  "halves": {
    "default": {
      "provides": [
        "http.route"
      ],
      "requires": [
        "admin.auth",
        "agent.observe",
        "agent.runtime",
        "conversations.registry",
        "storage.sql"
      ],
      "optional": [
        "outbound.queue",
        "actor.inbox",
        "actor.mailbox"
      ]
    },
    "worker": {
      "provides": [
        "http.route"
      ],
      "requires": [
        "admin.auth",
        "actor.mailbox"
      ],
      "optional": []
    }
  },
  "generated": [
    "dashboard-files.ts"
  ],
  "dependencies": {
    "@pikit/contracts": "0.0.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@pikit/pi-adapter": "0.0.0"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
