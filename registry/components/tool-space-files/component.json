{
  "$schema": "../../schema/component.schema.json",
  "name": "tool-space-files",
  "version": "0.0.1",
  "description": "The files a space keeps, people's uploads and agents' saves alike: space.files (versions with their authors, a trash, text search, a change log with restore) over one actor per space and storage.blob, and for the agents that name space-files the files_ tools and a section, or in a project's space project_file_save and project_file_get.",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.1",
    "contracts": "0.0.1",
    "adapter": "0.0.1",
    "capabilities": [
      "storage.sql",
      "storage.blob",
      "actor.mailbox",
      "actor.inbox",
      "wakeups",
      "execution"
    ]
  },
  "optional": {
    "capabilities": [
      "workspace",
      "projects",
      "document.convert"
    ]
  },
  "provides": [
    "space.files",
    "agent.extension"
  ],
  "apps": {
    "worker": "worker"
  },
  "halves": {
    "default": {
      "provides": [
        "space.files",
        "agent.extension"
      ],
      "requires": [
        "storage.sql",
        "storage.blob",
        "actor.mailbox",
        "actor.inbox",
        "wakeups",
        "execution"
      ],
      "optional": [
        "workspace",
        "projects",
        "document.convert"
      ]
    },
    "worker": {
      "provides": [
        "space.files"
      ],
      "requires": [
        "actor.mailbox",
        "storage.blob"
      ],
      "optional": [
        "document.convert"
      ]
    }
  },
  "extensions": [
    "space-files"
  ],
  "dependencies": {
    "@pikit/contracts": "0.0.1",
    "@pikit/pi-adapter": "0.0.1",
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
