{
  "$schema": "../../schema/component.schema.json",
  "name": "runtime-pi",
  "version": "0.0.0",
  "description": "The agent runtime: Pi runs your agents, and this component plugs it into the app.",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.0",
    "contracts": "0.0.0",
    "adapter": "0.0.0",
    "capabilities": [
      "storage.sql"
    ]
  },
  "optional": {
    "capabilities": [
      "agent.definition",
      "model.provider",
      "model.credentials",
      "secrets",
      "agent.tool",
      "agent.extension",
      "execution",
      "workspace",
      "wakeups",
      "settings"
    ]
  },
  "provides": [
    "agent.runtime",
    "agent.conversations",
    "agent.submissions",
    "agent.observe",
    "model.complete",
    "agent.command"
  ],
  "dependencies": {
    "@pikit/contracts": "0.0.0",
    "@pikit/pi-adapter": "0.0.0",
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
