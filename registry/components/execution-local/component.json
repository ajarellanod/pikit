{
  "$schema": "../../schema/component.schema.json",
  "name": "execution-local",
  "version": "0.0.0",
  "description": "The agent's tools work on this server: its filesystem and its shell, with a git whose pushes are fenced and whose token the shell never sees.",
  "targets": [
    "server"
  ],
  "requires": {
    "pikit": "0.0.0",
    "adapter": "0.0.0",
    "capabilities": []
  },
  "optional": {
    "capabilities": [
      "secrets"
    ]
  },
  "provides": [
    "execution",
    "execution.shell"
  ],
  "dependencies": {
    "@pikit/pi-adapter": "0.0.0",
    "diff": "8.0.4",
    "isomorphic-git": "1.42.3",
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
