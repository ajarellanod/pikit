# deployment-celld: one node's settings, read by nodes/celld.service from /etc/celld/celld.env
# (mode 0600: it holds the bucket's keys). The same on every node but CELLD_NODE and the addresses.
# A template: replace every value. `celld --help` lists the rest.

# The fleet's bucket: the one `pikit up` deploys to (CELLD_BUCKET in the project's .env). It needs
# conditional writes: AWS S3, R2, Google Cloud Storage, Tigris; not Hetzner, DigitalOcean Spaces or
# Backblaze B2. `celld diagnose --bucket ...` checks it.
CELLD_BUCKET=s3://my-pikit-fleet
# For a bucket that is not AWS S3 (R2: https://<account id>.r2.cloudflarestorage.com, region auto):
#S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_REGION=eu-west-1
# The bucket's keys. On EC2, an instance role instead (delete these two). celld reads no ~/.aws files.
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# This node's identity: fixed, unique in the fleet, never given to another machine (letters, digits,
# dots, dashes, underscores). With CELLD_WATCH on a disk that survives (the unit's), a restart is the
# same node.
CELLD_NODE=node-a

# The public listener: reached only by Caddy (nodes/Caddyfile), never by the internet directly
# (nodes/firewall.nft). On the machine that runs Caddy, 127.0.0.1:8080; behind a Caddy elsewhere,
# this node's private address.
CELLD_ADDR=10.0.0.11:8080
# The internal listener: peer traffic (plain text) and an operator API without authentication. The
# private network only (a VPC, WireGuard, Tailscale): never a public address.
CELLD_INTERNAL_ADDR=10.0.0.11:8081
CELLD_ADVERTISE=10.0.0.11:8081
# Caddy sets X-Forwarded-Proto and X-Forwarded-Host: the Worker then sees the public https URL as its
# origin (the Telegram webhook registers itself there). Only behind a proxy that replaces both.
CELLD_TRUST_FORWARDED_HEADERS=1

# Idle conversations leave memory after this many seconds and wake from the node's disk or the bucket
# (about 0.1 to 0.4 s): unset, only memory pressure evicts, and a node fills up with idle ones.
CELLD_IDLE_EVICT_S=300
# Keep each conversation's history in the bucket from growing at every activation (epoch GC): a day.
#CELLD_LTX_RETENTION_SECS=86400
# Above the default 40 s only with TimeoutStopSec above it too.
#CELLD_SHUTDOWN_TOTAL_MS=40000
