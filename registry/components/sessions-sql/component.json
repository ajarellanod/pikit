{
  "$schema": "../../schema/component.schema.json",
  "name": "sessions-sql",
  "version": "0.0.0",
  "description": "Each conversation's Pi session in the app's SQL database: on a server's SQLite or in a Cloudflare Durable Object alike.",
  "targets": [
    "server",
    "cloudflare"
  ],
  "requires": {
    "pikit": "0.0.0",
    "adapter": "0.0.0",
    "capabilities": [
      "storage.sql"
    ]
  },
  "optional": {
    "capabilities": []
  },
  "provides": [
    "sessions.store"
  ],
  "dependencies": {
    "@pikit/pi-adapter": "0.0.0",
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
