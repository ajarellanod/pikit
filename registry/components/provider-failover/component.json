{
  "$schema": "../../schema/component.schema.json",
  "name": "provider-failover",
  "version": "0.0.0",
  "description": "Models that fail over to others: a chain of models of your providers, named `failover/<chain>`, answers with the first that is not failing (rate or usage limits, refused credentials, outages).",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.0",
    "contracts": "0.0.0",
    "adapter": "0.0.0",
    "capabilities": []
  },
  "optional": {
    "capabilities": [
      "model.provider",
      "model.credentials",
      "secrets",
      "health"
    ]
  },
  "provides": [
    "model.provider"
  ],
  "modelProviders": [
    "failover"
  ],
  "dependencies": {
    "@pikit/contracts": "0.0.0",
    "@pikit/pi-adapter": "0.0.0",
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ],
  "environment": []
}
