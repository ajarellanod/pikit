// The project on Cloudflare (deployment-cloudflare, SPEC §4.1): a Worker and one Durable Object per
// conversation, both running pikit.config.ts (its `worker` export and its default export).
//
// No "name": the Worker is named after package.json's "name", which `pikit up`, `status`, `logs`,
// `down` and `dev` pass as --name, so two projects never deploy over each other. Running wrangler by
// hand, pass --name too.
//
// Secrets are never here: `pikit up` uploads .env's with the version (--secrets-file), and
// `pikit dev` (wrangler dev) reads .env.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/pikit/deployment-cloudflare/worker.ts",
  // The UI projects, every folder of src/ with a package.json but src/pikit/: the dashboard (SPEC §5),
  // when the project has a UI (src/dashboard/, `pikit ui on`), and a component's own (its
  // component.json's `ui`: channel-web's src/chat/). Each is built before every bundle, by whoever runs
  // wrangler (`pikit up`, `pikit dev`, a `wrangler deploy` by hand, Workers Builds from Git), and its
  // build writes its component's module, src/pikit/<component>/<folder>-files.ts (admin-api's
  // dashboard-files.ts, channel-web's chat-files.ts), which the Worker bundles: a build that fails
  // stops the deploy, so no Worker ships an old or empty page. Without one it does nothing.
  // `watch_dir` is what `wrangler dev` watches to build and bundle again (with a build command it
  // watches nothing else): the Worker's own sources, src/pikit/ where each UI build writes its
  // module, so the app reloads with it (`pikit dev` builds a UI project again itself when its files
  // change). Never src/ (every UI project's node_modules and dist/, which a build writes, would start
  // it again), nor this file (wrangler builds again on its change already: twice at once failed).
  // A folder of src/ of your own that the Worker imports: add it here.
  "build": {
    "command": "for project in src/*/package.json; do dir=\"${project%/package.json}\"; if [ ! -f \"$project\" ] || [ \"$dir\" = src/pikit ]; then continue; fi; (cd \"$dir\" && bun install --frozen-lockfile && bun run build) || exit 1; done",
    "watch_dir": ["pikit.config.ts", "src/pikit", "src/agents", "src/extensions"]
  },
  "compatibility_date": "2026-09-01",
  // Components and Pi use node:* APIs that Workers provide with it (Buffer, crypto, process.env).
  "compatibility_flags": ["nodejs_compat"],
  // One object per conversation (C1). The entrypoint reads the binding as CONVERSATION.
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATION", "class_name": "Conversation" }]
  },
  // SQLite-backed: storage-do, the runtime (pi-durable) and submissions keep the conversation in the object's SQL.
  // A migration is forever: add new ones below, never edit or remove this one.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation"] }],
  // The version /health reports: `pikit up` waits until it is the one it deployed (C8).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Logs kept by Cloudflare (Workers Logs, in the dashboard); `pikit logs` streams them live.
  "observability": { "enabled": true },
  // A prompt in a .md file is imported as text; a WebAssembly module is compiled at deploy (a Worker
  // cannot compile one at run time). A rule matches the import as written, so a module imported by a
  // package export without `.wasm` is named: execution-do's QuickJS.
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm", "@jitl/quickjs-wasmfile-release-sync/wasm"], "fallthrough": true }
  ]
}
