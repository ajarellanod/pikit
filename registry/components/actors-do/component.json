{
  "$schema": "../../schema/component.schema.json",
  "name": "actors-do",
  "version": "0.0.1",
  "description": "Reaches each conversation's Durable Object from the Worker, and wakes components in it on its one alarm: actor.mailbox, actor.inbox and wakeups on Cloudflare.",
  "targets": [
    "durable"
  ],
  "requires": {
    "pikit": "0.0.1",
    "contracts": "0.0.1",
    "capabilities": []
  },
  "optional": {
    "capabilities": []
  },
  "provides": [
    "wakeups",
    "actor.inbox",
    "actor.mailbox"
  ],
  "apps": {
    "worker": "default"
  },
  "dependencies": {
    "@pikit/contracts": "0.0.1",
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
