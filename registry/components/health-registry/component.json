{
  "$schema": "../../schema/component.schema.json",
  "name": "health-registry",
  "version": "0.0.0",
  "description": "What is up, degraded or down: components report their own state; /health fails when an essential one stays down, so the supervisor restarts the process.",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.0",
    "contracts": "0.0.0",
    "capabilities": []
  },
  "optional": {
    "capabilities": [
      "storage.kv",
      "admin.auth"
    ]
  },
  "provides": [
    "health",
    "http.route"
  ],
  "view": "view",
  "dependencies": {
    "@pikit/contracts": "0.0.0",
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
