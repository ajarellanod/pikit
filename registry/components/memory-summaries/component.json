{
  "$schema": "../../schema/component.schema.json",
  "name": "memory-summaries",
  "version": "0.0.1",
  "description": "Summarizes each conversation that went quiet into the memory of its person, credentials redacted: read from the answers feed with a cursor, woken by wakeups, idempotent across retries and restarts.",
  "targets": [
    "server"
  ],
  "requires": {
    "pikit": "0.0.1",
    "contracts": "0.0.1",
    "capabilities": [
      "storage.sql",
      "wakeups",
      "agent.submissions",
      "agent.observe",
      "model.complete",
      "memory"
    ]
  },
  "optional": {
    "capabilities": []
  },
  "provides": [],
  "dependencies": {
    "@pikit/contracts": "0.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@pikit/pi-adapter": "0.0.1"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
