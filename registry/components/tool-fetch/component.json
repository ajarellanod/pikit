{
  "$schema": "../../schema/component.schema.json",
  "name": "tool-fetch",
  "version": "0.0.0",
  "description": "The `fetch` tool, for the agents that name it: one HTTP(S) request to a web page or an API, with HTML as readable text and links, JSON pretty-printed, and binary content refused.",
  "targets": [
    "server",
    "durable"
  ],
  "requires": {
    "pikit": "0.0.0",
    "contracts": "0.0.0",
    "adapter": "0.0.0",
    "capabilities": []
  },
  "optional": {
    "capabilities": []
  },
  "provides": [
    "agent.tool"
  ],
  "replay": {
    "tools": {
      "fetch": "unsafe"
    }
  },
  "dependencies": {
    "@pikit/contracts": "0.0.0",
    "@pikit/pi-adapter": "0.0.0"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
    }
  ]
}
