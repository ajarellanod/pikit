  "dependencies": {
    "@pikit/contracts": "0.0.0",
    "@pikit/pi-adapter": "0.0.0"
  },
  "devDependencies": {
    "typebox": "1.3.27"
  },
  "files": [
    {
      "source": "files/src",
      "target": "src"
