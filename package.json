{
  "name": "pikit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tests/workerd"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "test:workerd": "bun run --cwd tests/workerd typecheck && bun run --cwd tests/workerd test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "registry": "bun scripts/registry.ts",
    "pikit": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "workspace:@pikit/pi-extension-shim@*",
    "@pikit/contracts": "workspace:*",
    "@pikit/core": "workspace:*",
    "@pikit/pi-adapter": "workspace:*",
    "@types/bun": "^1.4.2",
    "hono": "4.13.9",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "wrangler": "4.143.0"
  }
}
