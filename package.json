{
  "name": "pikit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tests/workerd"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "test:workerd": "bun run --cwd tests/workerd typecheck && bun run --cwd tests/workerd test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "registry": "bun scripts/registry.ts",
    "pikit": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@better-auth/test-utils": "1.7.7",
    "@earendil-works/gondolin": "0.13.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@pikit/contracts": "workspace:*",
    "@pikit/core": "workspace:*",
    "@pikit/pi-adapter": "workspace:*",
    "@types/bun": "^1.4.2",
    "better-auth": "1.7.7",
    "croner": "10.0.1",
    "diff": "8.0.4",
    "hono": "4.13.9",
    "isomorphic-git": "1.42.3",
    "just-bash": "3.4.2",
    "oxlint": "1.87.0",
    "quickjs-emscripten-core": "0.32.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "wrangler": "4.143.0"
  }
}
